{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "jiyu",
  "autoupdate": false,
  "lsp": {},
  "plugin": ["opencode-wakatime", "@mohak34/opencode-notifier@0.8.1", "context-mode@1.0.169"],
  "instructions": ["~/.config/opencode/instructions/shell.md"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "jiyu": {
      "mode": "primary",
      "description": "Own a goal through jiyu-mode routing, implementation and verification",
      "prompt": "{file:./prompts/jiyu.md}"
    },
    "assistant": {
      "mode": "all",
      "description": "Personal budgeting, read-only Gmail and AFFiNE notes, plans and reviews; no software implementation",
      "prompt": "{file:./prompts/assistant.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "list": "allow",
        "grep": "allow",
        "external_directory": "allow",
        "skill": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "actualbudget_*": "allow",
        "affine_*": "allow",
        "documents_read": "allow",
        "google_search_gmail_messages": "allow",
        "google_get_gmail_message_content": "allow",
        "google_get_gmail_messages_content_batch": "allow",
        "google_get_gmail_thread_content": "allow",
        "google_get_gmail_threads_content_batch": "allow",
        "google_get_gmail_attachment_content": "allow",
        "google_list_gmail_labels": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "description": "Complete a bounded implementation or investigation assignment",
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "task": "deny"
      }
    },
    "explore": {
      "permission": {
        "task": "deny",
        "edit": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Read-only correctness, comment and maintainability review",
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "task": "deny",
        "edit": "deny"
      }
    }
  },
  "mcp": {
    "actualbudget": {
      "type": "local",
      "command": ["opencode-assistant", "run", "actualbudget"],
      "enabled": true,
      "timeout": 30000
    },
    "affine": {
      "type": "local",
      "command": ["opencode-assistant", "run", "affine"],
      "enabled": true,
      "timeout": 30000
    },
    "documents": {
      "type": "local",
      "command": ["opencode-assistant", "run", "documents"],
      "enabled": true,
      "timeout": 120000
    },
    "google": {
      "type": "remote",
      "url": "https://gmcp.shupi.ushira.com/mcp",
      "headers": {
        "X-Workspace-MCP-Profile": "gmail-readonly"
      },
      "oauth": {
        "scope": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/gmail.readonly"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "actualbudget_*": "deny",
    "affine_*": "deny",
    "documents_*": "deny",
    "google_*": "deny",
    "question": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git branch -D*": "ask",
      "gh pr merge*": "ask",
      "gh repo delete*": "ask",
      "just build*": "ask",
      "just build-dry*": "allow",
      "just init*": "ask",
      "just deploy*": "ask",
      "nixos-rebuild*": "ask",
      "darwin-rebuild*": "ask"
    },
    "task": {
      "*": "deny",
      "general": "allow",
      "explore": "allow",
      "reviewer": "allow",
      "assistant": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/var/folders/*/*/T/opencode/**": "allow",
      "/private/var/folders/*/*/T/opencode/**": "allow",
      "~/nix-config/**": "allow",
      "~/.config/**": "allow",
      "~/Code/**": "allow",
      "~/Downloads/**": "allow"
    }
  }
}
