{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "direct",
  "autoupdate": false,
  "lsp": {},
  "plugin": ["opencode-wakatime", "@mohak34/opencode-notifier@0.8.1", "context-mode"],
  "instructions": ["~/.config/opencode/instructions/shell.md"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "planner": {
      "mode": "primary",
      "description": "Visible lane for big tasks: grills ambiguity, writes plans, and hands off to builder",
      "temperature": 0.1,
      "steps": 120,
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr checks*": "allow",
          "gh pr list*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow"
        },
        "edit": {
          "*": "deny",
          ".agents/**": "allow"
        }
      }
    },
    "builder": {
      "mode": "primary",
      "description": "Visible lane for executing approved planner handoffs",
      "temperature": 0.1,
      "steps": 80,
      "prompt": "{file:./prompts/build.md}"
    },
    "direct": {
      "mode": "primary",
      "description": "Default lane for routine coding, debugging, and bounded multi-file features",
      "temperature": 0.1,
      "steps": 120,
      "prompt": "{file:./prompts/direct.md}"
    },
    "sudo": {
      "mode": "primary",
      "description": "Visible lane for explicit operational chores, PRs, pipelines, and high-authority actions",
      "temperature": 0.1,
      "steps": 160,
      "prompt": "{file:./prompts/sudo.md}",
      "permission": {
        "*": "allow",
        "task": {
          "*": "allow",
          "planner": "deny",
          "builder": "deny",
          "direct": "deny",
          "sudo": "deny"
        }
      }
    },
    "general": {
      "permission": {
        "task": "deny"
      }
    },
    "explore": {
      "permission": {
        "task": "deny",
        "edit": "deny"
      }
    },
    "grind": {
      "mode": "subagent",
      "description": "Internal leaf capability for long-running checkpointed execution",
      "temperature": 0.1,
      "steps": 400,
      "prompt": "{file:./prompts/grind.md}",
      "permission": {
        "task": "deny"
      }
    },
    "audit": {
      "mode": "subagent",
      "description": "Internal leaf capability for code health and architecture risk review",
      "temperature": 0.1,
      "steps": 160,
      "prompt": "{file:./prompts/audit.md}",
      "permission": {
        "task": "deny",
        "edit": {
          "*": "deny",
          ".agents/**": "allow"
        }
      }
    },
    "ideate": {
      "mode": "subagent",
      "description": "Internal leaf capability for bounded optioning and direction setting",
      "temperature": 0.75,
      "steps": 160,
      "prompt": "{file:./prompts/ideate.md}",
      "permission": {
        "task": "deny",
        "edit": {
          "*": "deny",
          ".agents/**": "allow"
        }
      }
    },
    "writer": {
      "mode": "subagent",
      "description": "Internal leaf capability for personal-voice writing and documentation",
      "temperature": 0.75,
      "steps": 160,
      "prompt": "{file:./prompts/writer.md}",
      "permission": {
        "task": "deny",
        "edit": {
          "*": "deny",
          ".agents/**": "allow"
        }
      }
    }
  },
  "permission": {
    "ctx_*": "allow",
    "question": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "bash": {
      "*": "ask",
      "rm *": "ask",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "gh *": "ask",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "sudo *": "ask"
    },
    "list": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": {
      "*": "allow",
      "planner": "deny",
      "builder": "deny",
      "direct": "deny",
      "sudo": "deny"
    },
    "skill": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "ask",
      "~/nix-config/**": "allow",
      "~/.config/**": "allow",
      "~/Code/**": "allow",
      "~/Downloads/**": "allow",
      "/Users/shu/Documents/Obsidian Vault/**": "allow"
    }
  }
}
