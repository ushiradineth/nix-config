{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "jiyu",
  "instructions": ["~/.config/opencode/instructions/shell.md"],
  "mcp": {
    "servers": {
      "actualbudget": {
        "type": "local",
        "command": ["opencode-assistant", "run", "actualbudget"],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "disabled": false
      },
      "documents": {
        "type": "local",
        "command": ["opencode-assistant", "run", "documents"],
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        },
        "disabled": false
      },
      "google": {
        "type": "remote",
        "url": "https://gmcp.shupi.ushira.com/mcp",
        "headers": {
          "X-Workspace-MCP-Profile": "gmail-readonly"
        },
        "oauth": {
          "redirect_uri": "http://127.0.0.1:19876/mcp/oauth/callback",
          "scope": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/gmail.readonly"
        },
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "disabled": false
      }
    }
  },
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "jiyu": {
      "mode": "primary",
      "description": "Own a goal through jiyu-mode routing, implementation and verification",
      "system": "{file:./prompts/jiyu.md}"
    },
    "sudo-jiyu": {
      "mode": "primary",
      "description": "Own a goal through jiyu-mode routing, implementation and verification",
      "system": "{file:./prompts/jiyu.md}",
      "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }]
    },
    "assistant": {
      "mode": "all",
      "description": "Personal budgeting, read-only Gmail, tax preparation documents and local Obsidian notes; no software implementation",
      "system": "{file:./prompts/assistant.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "obsidian_read", "resource": "*", "effect": "allow" },
        { "action": "obsidian_create", "resource": "*", "effect": "allow" },
        { "action": "obsidian_edit", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "actualbudget_*", "resource": "*", "effect": "allow" },
        { "action": "documents_read", "resource": "*", "effect": "allow" },
        { "action": "google_search_gmail_messages", "resource": "*", "effect": "allow" },
        { "action": "google_get_gmail_message_content", "resource": "*", "effect": "allow" },
        { "action": "google_get_gmail_messages_content_batch", "resource": "*", "effect": "allow" },
        { "action": "google_get_gmail_thread_content", "resource": "*", "effect": "allow" },
        { "action": "google_get_gmail_threads_content_batch", "resource": "*", "effect": "allow" },
        { "action": "google_get_gmail_attachment_content", "resource": "*", "effect": "allow" },
        { "action": "google_list_gmail_labels", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "mode": "subagent",
      "description": "Complete a bounded implementation or investigation assignment",
      "system": "{file:./prompts/worker.md}",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "explore": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Read-only correctness, comment and maintainability review",
      "system": "{file:./prompts/reviewer.md}",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "title": {
      "model": "openai/gpt-6-luna"
    }
  },
  "update": "disable",
  "plugins": [
    "@wakatime/opencode-wakatime@1.0.0",
    "@mohak34/opencode-notifier@0.8.1",
    "context-mode@2.2.0"
  ],
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium"
      }
    }
  },
  "permissions": [
    { "action": "actualbudget_*", "resource": "*", "effect": "deny" },
    { "action": "documents_*", "resource": "*", "effect": "deny" },
    { "action": "obsidian_*", "resource": "*", "effect": "deny" },
    { "action": "google_*", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "git restore*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "ask" },
    { "action": "shell", "resource": "just build*", "effect": "ask" },
    { "action": "shell", "resource": "just build-dry*", "effect": "allow" },
    { "action": "shell", "resource": "just init*", "effect": "ask" },
    { "action": "shell", "resource": "just deploy*", "effect": "ask" },
    { "action": "shell", "resource": "nixos-rebuild*", "effect": "ask" },
    { "action": "shell", "resource": "darwin-rebuild*", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "general", "effect": "allow" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "subagent", "resource": "reviewer", "effect": "allow" },
    { "action": "subagent", "resource": "assistant", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "/var/folders/*/*/T/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*/*/T/opencode/**",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "~/nix-config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Code/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Downloads/**", "effect": "allow" }
  ],
  "experimental": {
    "todo": true
  }
}
