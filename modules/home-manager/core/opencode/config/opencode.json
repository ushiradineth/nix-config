{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "jiyu",
  "autoupdate": false,
  "lsp": {},
  "plugin": ["opencode-wakatime", "@mohak34/opencode-notifier@0.8.1", "context-mode"],
  "instructions": ["~/.config/opencode/instructions/shell.md"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "jiyu": {
      "mode": "primary",
      "description": "Own a goal through jiyu-mode routing, implementation and verification",
      "prompt": "{file:./prompts/jiyu.md}"
    },
    "general": {
      "mode": "subagent",
      "description": "Complete a bounded implementation or investigation assignment",
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "task": "deny"
      }
    },
    "explore": {
      "permission": {
        "task": "deny",
        "edit": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Read-only correctness, comment and maintainability review",
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "task": "deny",
        "edit": "deny"
      }
    }
  },
  "permission": {
    "question": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git branch -D*": "ask",
      "gh pr merge*": "ask",
      "gh repo delete*": "ask",
      "just build*": "ask",
      "just build-dry*": "allow",
      "just init*": "ask",
      "just deploy*": "ask",
      "nixos-rebuild*": "ask",
      "darwin-rebuild*": "ask"
    },
    "task": {
      "*": "deny",
      "general": "allow",
      "explore": "allow",
      "reviewer": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/var/folders/*/*/T/opencode/**": "allow",
      "/private/var/folders/*/*/T/opencode/**": "allow",
      "~/nix-config/**": "allow",
      "~/.config/**": "allow",
      "~/Code/**": "allow",
      "~/Downloads/**": "allow",
      "/Users/shu/Documents/Obsidian Vault/**": "allow"
    }
  }
}
