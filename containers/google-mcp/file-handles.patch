diff --git a/core/file_handles.py b/core/file_handles.py
new file mode 100644
--- /dev/null
+++ b/core/file_handles.py
@@ -0,0 +1,92 @@
+"""Account-bound resolution of this server's expiring attachment URLs."""
+
+import os
+import re
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from core import attachment_storage
+from core.file_limits import ensure_within_file_size_limit
+
+
+_FILE_ID = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}")
+
+
+def resolve_file_handle(
+    url: str, user_google_email: str | None
+) -> tuple[Path, dict] | None:
+    """Return a validated local source, or None for an unrelated remote URL.
+
+    Never fall back to a network request for an invalid or unauthorized handle.
+    Ordinary URLs still use the existing SSRF-safe fetch path.
+    """
+    from core.config import WORKSPACE_MCP_BASE_URI, WORKSPACE_MCP_PORT
+
+    base = os.getenv("WORKSPACE_EXTERNAL_URL") or (
+        f"{WORKSPACE_MCP_BASE_URI}:{WORKSPACE_MCP_PORT}"
+    )
+    expected = urlsplit(base.rstrip("/"))
+    parsed = urlsplit(url)
+    if (parsed.scheme.casefold(), parsed.netloc.casefold()) != (
+        expected.scheme.casefold(),
+        expected.netloc.casefold(),
+    ):
+        return None
+    prefix = expected.path.rstrip("/") + "/attachments/"
+    if not parsed.path.startswith(prefix):
+        return None
+    file_id = parsed.path[len(prefix) :]
+    if parsed.query or parsed.fragment or not _FILE_ID.fullmatch(file_id):
+        raise ValueError("Invalid MCP file handle; download the source again.")
+    storage = attachment_storage.get_attachment_storage()
+    metadata = storage.get_attachment_metadata(file_id)
+    path = storage.get_attachment_path(file_id)
+    if not metadata or path is None:
+        raise ValueError(
+            "MCP file handle expired or unavailable; download the source again."
+        )
+    owner = metadata.get("owner_email")
+    if (
+        not owner
+        or not user_google_email
+        or owner != user_google_email.strip().casefold()
+    ):
+        raise ValueError("MCP file handle is not authorized for this account.")
+    path = Path(path)
+    if (
+        path.is_symlink()
+        or path.resolve().parent != attachment_storage.STORAGE_DIR.resolve()
+    ):
+        raise ValueError("MCP file handle has an invalid storage path.")
+    ensure_within_file_size_limit(metadata["size"], kind="MCP file handle")
+    if path.stat().st_size != metadata["size"] or (
+        attachment_storage.file_sha256(path) != metadata["sha256"]
+    ):
+        raise ValueError(
+            "MCP file handle integrity check failed; download the source again."
+        )
+    return path, metadata
+
+
+async def authenticate_download(request, metadata: dict) -> str | None:
+    """Verify a download caller with the same OAuth provider as MCP requests."""
+    from core.server import get_auth_provider
+
+    owner = metadata.get("owner_email")
+    if not owner:
+        return None
+    header = request.headers.get("authorization", "")
+    provider = get_auth_provider()
+    if not header.startswith("Bearer ") or provider is None:
+        raise ValueError(
+            "Authenticate with this server's OAuth token to download the file."
+        )
+    try:
+        token = await provider.verify_token(header[7:])
+    except Exception:
+        token = None
+    claims = getattr(token, "claims", None) or {}
+    email = getattr(token, "email", None) or claims.get("email")
+    if not email or email.strip().casefold() != owner:
+        raise ValueError("MCP file handle is not authorized for this account.")
+    return email
